#include "../common.h"
#include "memoryHandle.h"
#include "lampStatusFinder/lampStatusFinder.h"
#include "externalNvs/flash_interface.h"
#include <string.h>
extern Display_Handle display1;
/* No debug UART on this board yet: logs compile to nothing.
 * Point this at a printf-style function to enable them. */
#defineDisplay_printf(display1, 0, 0,...)

storedDatas_t storedDatas;

static uint8_t crc8_cal(uint8_t *data, uint16_t length)
{
    uint8_t crc = 0x00;

    uint8_t extract;
    uint8_t sum;

    for (uint16_t i = 0; i < length; i++) {
        extract = *data;
        for (uint8_t tempI = 8; tempI; tempI--) {
            sum = (crc ^ extract) & 0x01;
            crc >>= 1;
            if (sum)
                crc ^= 0x8C;
            extract >>= 1;
        }
        data++;
    }

    return crc;
}

static int memoryHandle_readPage(uint8_t page, storedDatas_t *storedDatas)
{
    uint8_t ret;
    uint8_t crcTemp;

    memset(storedDatas, 0, sizeof(storedDatas_t));

    flash_open();
    ret = readFlashPg(page, 0, (uint8_t *)storedDatas, sizeof(storedDatas_t));
    flash_close();

    if (ret != FLASH_SUCCESS) {
       Display_printf(display1, 0, 0,"-1-memoryHandle:readPage %d read failed\r\n", page);
        return 1;
    }

    crcTemp = storedDatas->checksum;
    storedDatas->checksum = 0;
    storedDatas->checksum = crc8_cal((uint8_t *)storedDatas, sizeof(storedDatas_t));

   Display_printf(display1, 0, 0,"-1-memoryHandle:readPage %d storedCrc=%d calcCrc=%d\r\n",
                  page, crcTemp, storedDatas->checksum);

    /* Erased flash reads 0xFF: firstBoot check catches a blank sector whose
     * 0xFF bytes happen to match the crc. */
    if ((crcTemp != storedDatas->checksum) ||
        (storedDatas->firstBoot != CONFIG_STORE_FIRST_BOOT_MAGIC)) {
       Display_printf(display1, 0, 0,"-1-memoryHandle:readPage %d crc fail\r\n", page);
        return 1;
    }

    return 0;
}

static int memoryHandle_writePage(uint8_t page, storedDatas_t *storedDatas)
{
    int ret = 0;

    storedDatas->checksum = 0;
    storedDatas->checksum = crc8_cal((uint8_t *)storedDatas, sizeof(storedDatas_t));

    if (!flash_open()) {
       Display_printf(display1, 0, 0,"-1-memoryHandle:flash_open failed\r\n");
        return -1;
    }

    if (eraseFlashPg(page) != FLASH_SUCCESS) {
       Display_printf(display1, 0, 0,"-1-memoryHandle:erase page %d failed\r\n", page);
        ret = -1;
    } else if (writeFlashPg(page, 0, (uint8_t *)storedDatas, sizeof(storedDatas_t)) != FLASH_SUCCESS) {
       Display_printf(display1, 0, 0,"-1-memoryHandle:write page %d failed\r\n", page);
        ret = -1;
    }

    flash_close();
    return ret;
}

static int memoryHandle_readConfigStoreFile(void)
{
    return memoryHandle_readPage(CONFIG_STORE_PAGE, &storedDatas);
}

static int memoryHandle_writeConfigStoreFile(void)
{
    return memoryHandle_writePage(CONFIG_STORE_PAGE, &storedDatas);
}

static int memoryHandle_readConfigStoreBackupFile(void)
{
    return memoryHandle_readPage(CONFIG_STORE_BACKUP_PAGE, &storedDatas);
}

static int memoryHandle_writeConfigStoreBackupFile(void)
{
    return memoryHandle_writePage(CONFIG_STORE_BACKUP_PAGE, &storedDatas);
}

static void memoryHandle_loadDefaultConfigStore(void)
{
    memset(&storedDatas, 0, sizeof(storedDatas));
    storedDatas.Minvoltage      = MIN_VOLT;
    storedDatas.Minpower        = MIN_POWER;
    storedDatas.periodicTime    = PERIODIC_DURATION;
    storedDatas.maxPayload      = MAX_PAYLOAD_PER_DAY;
    storedDatas.maxPayloadCounter = 0;
    storedDatas.currentDay      = 0;
    storedDatas.firstBoot       = CONFIG_STORE_FIRST_BOOT_MAGIC;
    storedDatas.lastFaultStatus = FAULT_NONE;
    storedDatas.lampBurnTime    = 0;
    storedDatas.energyWh        = 0;
    storedDatas.batTh           = BATVOLT_LOW_THRESHOLD;

    memoryHandle_writeConfigStoreWithBackup();
   Display_printf(display1, 0, 0,"-1-memoryHandle:storedDatas loadDefaultConfigStore\r\n");
}

/* Returns 0 when both copies were written, -1 if either failed */
int memoryHandle_writeConfigStoreWithBackup(void)
{
    int ret = 0;

    if (memoryHandle_writeConfigStoreBackupFile() != 0) {
        ret = -1;
    }
    if (memoryHandle_writeConfigStoreFile() != 0) {
        ret = -1;
    }
    return ret;
}

void memoryHandle_readConfigStoreWithBackup(void)
{
    if (memoryHandle_readConfigStoreFile()) {
       Display_printf(display1, 0, 0,"-1-memoryHandle:storedDatas memoryHandle_readConfigStoreFile crc fail\r\n");
        if (memoryHandle_readConfigStoreBackupFile()) {
           Display_printf(display1, 0, 0,"-1-memoryHandle:storedDatas memoryHandle_readConfigStoreBackupFile crc fail\r\n");
            memoryHandle_loadDefaultConfigStore();
        } else {
            /* Backup good, primary bad: repair primary */
            memoryHandle_writeConfigStoreFile();
        }
    }

    if (storedDatas.batTh == 0) {
        storedDatas.batTh = BATVOLT_LOW_THRESHOLD;
       Display_printf(display1, 0, 0,"-1-memoryHandle:batTh not set, default=%lu\r\n", (unsigned long)storedDatas.batTh);
        /* Save the fix so it isn't repeated on every boot */
        memoryHandle_writeConfigStoreWithBackup();
    }
}

/* Call once at startup, after flash_init() */
void memoryHandle_firstBoot(void)
{
    memoryHandle_readConfigStoreWithBackup();
}

storedDatas_t *memoryHandle_getConfigStore(void)
{
    return &storedDatas;
}
