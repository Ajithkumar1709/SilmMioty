
/* ---------------- lamp_monitor.c ---------------- */
#include "lampStatusFinder.h"
#include"memoryHandler/memoryHandle.h"
#include <string.h>
/* Module-private state */
static uint8_t   lampPreviousState = LAMP_UNKNOWN;
static uint32_t  periodicDataTimer = 0;

static bool      bootOnPkt = true;
static uint32_t  faultStatusPrevious = FAULT_NONE;

/* Lamp-fault debounce state */
static uint8_t lampFaultSetCounter   = 0;
static uint8_t lampFaultClearCounter = 0;
static bool    lampFaultLatched      = false;
static uint8_t lastRawState          = LAMP_UNKNOWN;  /* latest reading, for isFaultDebouncing() */

void lampMonitor_init(void)
{
    uint32_t persistedFaultStatus =memoryHandle_getConfigStore()->lastFaultStatus;

    periodicDataTimer   = 0;
    bootOnPkt           = true;
    faultStatusPrevious = persistedFaultStatus;

    lampPreviousState = LAMP_UNKNOWN;

    if (persistedFaultStatus & FAULT_LAMP_BIT) {
        /* Lamp fault was active before power-off: resume already-latched
         * so the fault is reported again without waiting for a fresh
         * debounce confirmation. */
        lampFaultSetCounter   = LAMP_FAULT_DEBOUNCE_COUNT;
        lampFaultClearCounter = 0;
        lampFaultLatched      = true;
    } else {
        lampFaultSetCounter   = 0;
        lampFaultClearCounter = LAMP_FAULT_DEBOUNCE_COUNT;
        lampFaultLatched      = false;
    }

      Display_printf(display1, 0, 0, "-1-lampStatusFinder:init persistedFaultStatus=%lu\r\n", (unsigned long)persistedFaultStatus);
}

void lampMonitor_requestBootOnPkt(void)
{
    bootOnPkt = true;
}

/* Pure function: raw instantaneous lamp state from voltage/current readings */
uint8_t lampMonitor_evaluateState(uint32_t voltage, uint32_t power, uint32_t minV, uint32_t minW)
{
    if ((voltage > minV) && (power > minW)) {
        return LAMP_ON;
    } else if ((voltage < minV) && (power < minW)) {
        return LAMP_OFF;
    } else if ((voltage > minV) && (power < minW)) {
        return LAMP_FAULT;
    }
    return LAMP_UNKNOWN;
}

/* Fault latch: LAMP_FAULT raw condition must occur LAMP_FAULT_DEBOUNCE_COUNT
 * times consecutively to SET, and LAMP_ON must occur LAMP_FAULT_DEBOUNCE_COUNT
 * times consecutively to CLEAR. LAMP_OFF/LAMP_UNKNOWN are ambiguous readings
 * and leave the latch untouched. While a fault is not yet confirmed, the
 * reported lmpState holds its previous value (see isPacketSendRequired).
 */
static void lampMonitor_updateFaultLatch(uint8_t rawState)
{
    if (rawState == LAMP_FAULT) {
        lampFaultClearCounter = 0;
        if (lampFaultSetCounter < LAMP_FAULT_DEBOUNCE_COUNT) {
            lampFaultSetCounter++;
        }
        if (lampFaultSetCounter >= LAMP_FAULT_DEBOUNCE_COUNT) {
            lampFaultLatched = true;
        }
    } else if (rawState == LAMP_ON) {
        lampFaultSetCounter = 0;
        if (lampFaultClearCounter < LAMP_FAULT_DEBOUNCE_COUNT) {
            lampFaultClearCounter++;
        }
        if (lampFaultClearCounter >= LAMP_FAULT_DEBOUNCE_COUNT) {
            lampFaultLatched = false;
        }
    }
    /* rawState == LAMP_OFF or LAMP_UNKNOWN: hold latch as-is */
}

/* True while a lamp fault SET or CLEAR is being confirmed: the latest
 * reading points the other way from the latch but the debounce count isn't
 * reached yet. Based on the latest reading (not the counters alone) so a
 * leftover partial count while the lamp is OFF doesn't keep this true. */
bool lampMonitor_isFaultDebouncing(void)
{
#if DEBOUNCE_LAMPSTATE
    return ((lastRawState == LAMP_FAULT) && !lampFaultLatched) ||
           ((lastRawState == LAMP_ON) && lampFaultLatched);
#else
    return false;
#endif
}

#if FEATURE_BATVOLT_MONITOR
/* Pure function: decide low-battery bool with hysteresis */
static bool lampMonitor_evaluateBatLow(uint32_t batVolt, bool prevBatLow, uint32_t batTh)
{
    if (!prevBatLow && (batVolt < batTh)) {
        return true;
    }
    if (prevBatLow && (batVolt > (batTh + BATVOLT_LOW_HYSTERESIS))) {
        return false;
    }
    return prevBatLow;
}
#endif

/* Build bitwise faultStatus from the (debounced) fault latch + batlow flag */
static uint32_t lampMonitor_buildFaultStatus(bool lampFault, bool batLow)
{
    uint32_t fault = FAULT_NONE;

#if FEATURE_FAULT_MONITOR
    if (lampFault) {
        fault |= FAULT_LAMP_BIT;
    }

    #if FEATURE_BATVOLT_MONITOR
    if (batLow) {
        fault |= FAULT_BAT_BIT;
    }
    #else
    (void)batLow;
    #endif

#else
    (void)lampFault;
    (void)batLow;
#endif

    return fault;
}

static void lampMonitor_persistFaultStatus(void)
{
    memoryHandle_getConfigStore()->lastFaultStatus = faultStatusPrevious;
    memoryHandle_writeConfigStoreWithBackup();
}

/* Decide whether/what packet to send. At most one packet per call; when
 * several events are pending they go out on following calls in priority
 * order: boot > fault set > fault clear > lamp on/off > live. */
serveTransmitPkt_t lampMonitor_isPacketSendRequired(uint32_t voltage,
                                                     uint32_t power,
                                                     uint32_t batVolt,
                                                     bool periodicStatus,
                                                     uint32_t minW,
                                                     uint32_t minV,
                                                     uint32_t batTh)
{
    serveTransmitPkt_t pkt;
    bool batLowNow = false;
    bool lampFaultNow;
    uint32_t setBits, clearBits;
    uint8_t rawState;

   memset(&pkt,0,sizeof(pkt));
    pkt.voltage = voltage;
    pkt.power = power;
    pkt.pktType = PKT_NONE;

    rawState = lampMonitor_evaluateState(voltage, power, minV, minW);
    pkt.lmpState = rawState;
    lastRawState = rawState;

#if DEBOUNCE_LAMPSTATE
    lampMonitor_updateFaultLatch(rawState);
    lampFaultNow = lampFaultLatched;
#else
    lampFaultNow = (rawState == LAMP_FAULT);
#endif

    /* Fault SET/CLEAR needs LAMP_FAULT_DEBOUNCE_COUNT consecutive readings.
     * - Latched: always report LAMP_FAULT (held until 3x ON clears it).
     * - Raw FAULT not yet confirmed: hold the last reported state, or
     *   LAMP_UNKNOWN on a boot packet (no trustworthy previous state).
     * - Otherwise ON/OFF is reported immediately (single reading). */
    if (lampFaultNow) {
        pkt.lmpState = LAMP_FAULT;
    } else if (rawState == LAMP_FAULT) {
        pkt.lmpState = bootOnPkt ? LAMP_UNKNOWN : lampPreviousState;
    }

#if FEATURE_BATVOLT_MONITOR
    pkt.batVolt = (uint16_t)batVolt;
    batLowNow = lampMonitor_evaluateBatLow(batVolt, (faultStatusPrevious & FAULT_BAT_BIT) != 0, batTh);
#else
    pkt.batVolt = 0;
#endif

    pkt.faultStatus = lampMonitor_buildFaultStatus(lampFaultNow, batLowNow);

    setBits   = pkt.faultStatus & ~faultStatusPrevious;
    clearBits = faultStatusPrevious & ~pkt.faultStatus;

    /* 1. Boot packet has highest priority */
    if (bootOnPkt) {
        lampPreviousState   = pkt.lmpState;
        if (pkt.faultStatus != faultStatusPrevious) {
            faultStatusPrevious = pkt.faultStatus;
            lampMonitor_persistFaultStatus();
        }
        bootOnPkt = false;
        pkt.pktType = PKT_BOOTON;
         Display_printf(display1, 0, 0, "-1-lampStatusFinder:PKT_BOOTON, lmpState=%u, faultStatus=%lu\r\n", pkt.lmpState, (unsigned long)pkt.faultStatus);
        return pkt;
    }

    /* 2. Fault set: fc = newly set bits */
    if (setBits) {
        faultStatusPrevious |= setBits;
        lampPreviousState    = pkt.lmpState;
        pkt.faultChanged     = setBits;
        pkt.pktType          = PKT_FAULT_SET;
        lampMonitor_persistFaultStatus();
         Display_printf(display1, 0, 0, "-1-lampStatusFinder:PKT_FAULT_SET, fc=%lu, fd=%lu\r\n", (unsigned long)setBits, (unsigned long)pkt.faultStatus);
        return pkt;
    }

    /* 3. Fault clear: fc = newly cleared bits */
    if (clearBits) {
        faultStatusPrevious &= ~clearBits;
        lampPreviousState    = pkt.lmpState;
        pkt.faultChanged     = clearBits;
        pkt.pktType          = PKT_FAULT_CLEAR;
        lampMonitor_persistFaultStatus();
        Display_printf(display1, 0, 0, "-1-lampStatusFinder:PKT_FAULT_CLEAR, fc=%lu, fd=%lu\r\n", (unsigned long)clearBits, (unsigned long)pkt.faultStatus);
        return pkt;
    }

    /* 4. Lamp turned ON / OFF (FAULT is reported via fault set; UNKNOWN never
     *    triggers and doesn't overwrite the previous state) */
    if ((pkt.lmpState != lampPreviousState) &&
        ((pkt.lmpState == LAMP_ON) || (pkt.lmpState == LAMP_OFF))) {
        lampPreviousState = pkt.lmpState;
        pkt.pktType = (pkt.lmpState == LAMP_ON) ? PKT_LAMP_ON : PKT_LAMP_OFF;
        Display_printf(display1, 0, 0, "-1-lampStatusFinder:%s, fd=%lu\r\n", (pkt.pktType == PKT_LAMP_ON) ? "PKT_LAMP_ON" : "PKT_LAMP_OFF", (unsigned long)pkt.faultStatus);
        return pkt;
    }

    /* 5. Periodic live packet */
    if (periodicStatus) {
        pkt.pktType = PKT_LIVE;
        return pkt;
    }

    return pkt;
}
